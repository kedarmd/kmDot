[Unit]
Description=Start the selected kmDot dictation provider
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.config/kmdot/quickshell/scripts/dictation-provider.sh start
ExecStop=%h/.config/kmdot/quickshell/scripts/dictation-provider.sh stop

[Install]
WantedBy=graphical-session.target
