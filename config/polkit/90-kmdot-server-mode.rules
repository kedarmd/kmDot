// Allow members of the wheel group to manage the kmDot server-mode services
// (tailscaled, jellyfin, docker, containerd) without a password prompt, so the
// quickshell bar can start/stop them with one click.
//
// Install: sudo install -Dm644 90-kmdot-server-mode.rules /etc/polkit-1/rules.d/
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit");
    if (subject.isInGroup("wheel") &&
        (unit === "tailscaled.service" || unit === "jellyfin.service" ||
         unit === "docker.service" || unit === "containerd.service")) {
      return polkit.Result.YES;
    }
  }
});