{
  "on-sigusr1": "toggle",
  "layer": "top",
  "position": "top",

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/kmdot", "custom/clock", "custom/dnd"],
  "modules-right": ["network", "bluetooth", "pulseaudio", "backlight", "power-profiles-daemon", "battery"],

  "hyprland/workspaces": {
    "format": "{id}",
    "active-only": false,
    "all-outputs": true,
    "on-click": "activate",
    "sort-by": "number",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },

  "custom/kmdot": {
    "format": " kmDot",
    "tooltip": "kmDot dotfiles",
    "on-click": "$HOME/.config/rofi/menu/kmdot.sh",
    "tooltip": false
  },

  "custom/dnd": {
    "exec-if": "command -v swaync-client",
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d",
    "tooltip": true
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "interval": 3
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "tooltip": true,
    "format-icons": {
        "default": "",
        "performance": " Turbo",
        "balanced": " Norm",
        "power-saver": " Echo"
    },
    "interval": 60,
    "on-click": "~/.config/kmdot/rofi/menu/power_profile.sh"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-disabled": "{icon}",
    "format-disconnected": "{icon}",
    "format-icons": {
      "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": "󰈁",
      "disconnected": "󰤯",
      "disabled": "󰤮"
    },
    "tooltip-format": "Connected to: {essid}",
    "interval": 60,
    "on-click": "~/.config/kmdot/rofi/menu/wifi.sh",
    "on-click-right": "nmcli radio wifi off >/dev/null 2>&1"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "format-device-preference": [
      "headphones",
      "earbuds",
      "speaker"
    ],
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{controller_alias}: {num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power off"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Mute",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 2,
    "on-click": "pamixer -t",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
    "on-scroll-up": "~/.config/waybar/scripts/brightness.sh up",
    "on-scroll-down": "~/.config/waybar/scripts/brightness.sh down"
  }
}
